# Base URL of the ai-agentic-kernel API service (STEP-01). Defaults to
# http://localhost:8000 in code if unset.
VITE_API_BASE_URL=http://localhost:8000

# Optional: sent as X-API-Key on every request, matching the backend's optional
# AGENTIC_KERNEL_API_KEY check. Leave unset for local dev (no header sent, matches the
# backend's own auth-off default).
#
# SECURITY: this gets baked into the built JS bundle -- anyone who can load the deployed
# UI can view-source this value out of it. Only set this for a real deployment if the UI
# itself isn't fully public, or you accept that this single shared key is then effectively
# public too. The UI is hosted on AWS Amplify -- set this as a build-time environment
# variable in the Amplify app's settings, not in a committed file.
# VITE_API_KEY=
